# Backend que ENVÍA los avisos de Teams (el que firma los enlaces con su TEAMS_TAB_SECRET).
# Se llama desde este contenedor, no desde el navegador. Usar el dominio del API (certificado válido),
# p. ej. el valor de CORE_API_PROD / CORE_API_STAGING del reverse proxy.
BACKEND_URL=https://api-core.ejemplo.com

# Puerto del servidor donde se publica (solo en 127.0.0.1)
HOST_PORT=6090

# Solo si el backend usa un certificado de una CA interna: montar el .crt y descomentar
# NODE_EXTRA_CA_CERTS=/certs/ca.crt
